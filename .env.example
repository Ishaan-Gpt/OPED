# Copy to .env.local and fill in real values. Never commit real values.

# Adaptive teacher decisions (src/lib/teacher/decide.ts) — Groq (OpenAI-compatible).
# Get a free key at https://console.groq.com/keys — without this, the app silently falls back to
# "continue" for every decision and NO video ever generates (this is the #1 cause of "no videos").
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Bedrock (unused while GROQ_API_KEY is set; kept for the AWS path — see REMOTION_AWS_DEPLOY.md)
AWS_REGION=ap-south-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_KNOWLEDGE_BASE_ID=

# Remotion rendering
# "local" renders on this machine (dev). "lambda" renders on AWS Lambda (prod).
REMOTION_RENDER_TARGET=local
REMOTION_AWS_FUNCTION_NAME=
REMOTION_AWS_SERVE_URL=
REMOTION_AWS_BUCKET_NAME=
